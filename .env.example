# Copy to .env.local (git-ignored). Never commit real values.

# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Bypasses RLS. Used by the match scorer and seed script.
SUPABASE_SECRET_KEY=sb_secret_...

# --- ElevenLabs Agents (Conversational AI) ---
# Server only. Used to mint signed URLs for private agents.
ELEVENLABS_API_KEY=
# Agent IDs are not secrets once the agent has auth enabled (signed URL required).
NEXT_PUBLIC_ELEVENLABS_AGENT_ID_EMPLOYEE=
NEXT_PUBLIC_ELEVENLABS_AGENT_ID_EMPLOYER=

# --- Anthropic (resume parsing only) ---
ANTHROPIC_API_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Phase 0 operations (server only) ---
DATABASE_URL=postgresql://postgres.PROJECT-REF:ROTATED-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
CRON_SECRET=replace-with-at-least-32-characters
ADMIN_API_SECRET=replace-with-at-least-32-characters
ANTHROPIC_MODEL=claude-sonnet-4-6
MODEL_DAILY_BUDGET_USD=20
MODEL_DEGRADED_MODE=false

# --- Messaging (server only) ---
GHL_LOCATION_ID=
GHL_PRIVATE_INTEGRATION_KEY=
GHL_WEBHOOK_SECRET=replace-with-at-least-32-characters
GMAIL_USER=
GMAIL_APP_PASSWORD=
